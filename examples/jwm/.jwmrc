<?xml version="1.0" ?>
<JWM>
  <!-- Generated from LXDE configuration -->
  <RootMenu onroot="12">
    <Program icon="utilities-terminal" label="Terminal">terminator</Program>
    <Menu icon="folder" label="Applications">
      <Menu label="Web Browsers">
        <Program label="Chromium">gtk-launch chromium.desktop</Program>
      </Menu>
      <Menu label="Development">
        <Program label="Cursor">gtk-launch cursor.desktop</Program>
      </Menu>
      <Menu label="Office">
        <Program label="Libreoffice Base">gtk-launch libreoffice-base.desktop</Program>
      </Menu>
      <Menu label="Graphics">
        <Program label="Org.Gnome.Cheese">gtk-launch org.gnome.Cheese.desktop</Program>
      </Menu>
      <Menu label="Databases">
        <Program label="Beekeeper Studio">gtk-launch beekeeper-studio.desktop</Program>
      </Menu>
      <Program icon="web-browser" label="Web Browser">/usr/bin/vivaldi-stable</Program>
    </Menu>
    <Separator/>
    <Program icon="lock" label="Lock Screen">lxlock</Program>
    <Separator/>
    <Restart label="Restart JWM" icon="reload"/>
    <Exit label="Exit" confirm="true" icon="exit"/>
  </RootMenu>
  <Tray x="0" y="-1" autohide="on" delay="1000" height="30">
    <TrayButton label="Menu">root:1</TrayButton>
    <Spacer width="2"/>
    <TrayButton label="_">showdesktop</TrayButton>
    <Spacer width="2"/>
    <Pager labeled="true"/>
    <TaskList maxwidth="256"/>
    <Dock/>
    <Clock format="%Y-%m-%d %H:%M">
      <Button mask="123">exec:xclock</Button>
    </Clock>
  </Tray>
  <WindowStyle decorations="motif">
    <Font>Sans-8:bold</Font>
    <Width>4</Width>
    <Corner>0</Corner>
    <Foreground>#FFFFFF</Foreground>
    <Background>#555555</Background>
    <Opacity>1.0</Opacity>
    <Active>
      <Foreground>#FFFFFF</Foreground>
      <Background>#0077CC</Background>
      <Opacity>1.0</Opacity>
    </Active>
  </WindowStyle>
  <TrayStyle decorations="motif">
    <Font>Sans-10</Font>
    <Background>#333333</Background>
    <Foreground>#FFFFFF</Foreground>
    <Opacity>0.95</Opacity>
  </TrayStyle>
  <TaskListStyle list="all" group="true">
    <Font>Sans-10</Font>
    <Foreground>#FFFFFF</Foreground>
    <Background>#333333</Background>
    <Active>
      <Foreground>#FFFFFF</Foreground>
      <Background>#555555</Background>
    </Active>
  </TaskListStyle>
  <PagerStyle>
    <Foreground>#555555</Foreground>
    <Background>#333333</Background>
    <Text>#FFFFFF</Text>
    <Active>
      <Foreground>#0077CC</Foreground>
      <Background>#004488</Background>
    </Active>
  </PagerStyle>
  <MenuStyle decorations="motif">
    <Font>Sans-10</Font>
    <Foreground>#FFFFFF</Foreground>
    <Background>#333333</Background>
    <Active>
      <Foreground>#FFFFFF</Foreground>
      <Background>#0077CC</Background>
    </Active>
    <Opacity>0.85</Opacity>
  </MenuStyle>
  <IconPath>/usr/share/icons</IconPath>
  <IconPath>/usr/share/pixmaps</IconPath>
  <IconPath>/usr/local/share/icons</IconPath>
  <Desktops width="2" height="1">
    <!-- Desktop 0: Amanda -->
    <!-- Desktop 1: Scot -->
    <Background type="solid">#111111</Background>
  </Desktops>
  <FocusModel>sloppy</FocusModel>
  <DoubleClickSpeed>400</DoubleClickSpeed>
  <DoubleClickDelta>2</DoubleClickDelta>
  <SnapMode distance="10">border</SnapMode>
  <MoveMode>opaque</MoveMode>
  <ResizeMode>opaque</ResizeMode>
  <Key key="Up">up</Key>
  <Key key="Down">down</Key>
  <Key key="Right">right</Key>
  <Key key="Left">left</Key>
  <Key key="Return">select</Key>
  <Key key="Escape">escape</Key>
  <Key mask="CA" key="Left">ldesktop</Key>
  <Key mask="CA" key="Right">rdesktop</Key>
  <Key mask="CA" key="Up">udesktop</Key>
  <Key mask="CA" key="Down">ddesktop</Key>
  <Key mask="AS" key="Left">sendl</Key>
  <Key mask="AS" key="Right">sendr</Key>
  <Key mask="AS" key="Up">sendu</Key>
  <Key mask="AS" key="Down">sendd</Key>
  <Key mask="4" key="d">showdesktop</Key>
  <Key mask="CA" key="d">showdesktop</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="Escape">lower</Key>
  <Key mask="A" key="space">root:1</Key>
  <Key mask="A" key="Tab">nextstacked</Key>
  <Key mask="AS" key="Tab">prevstacked</Key>
  <Key mask="CA" key="Tab">nextstacked</Key>
  <Key mask="4" key="e">exec:pcmanfm</Key>
  <Key mask="4" key="f">exec:pcmanfm --find-files</Key>
  <Key mask="4" key="r">exec:lxpanelctl run</Key>
  <Key mask="A" key="F2">exec:lxpanelctl run</Key>
  <Key mask="C" key="Escape">exec:lxpanelctl menu</Key>
  <Key mask="A" key="F1">exec:lxpanelctl menu</Key>
  <Key mask="A" key="F11">fullscreen</Key>
  <Key mask="CA" key="Delete">exec:lxtask</Key>
  <Key key="Print">exec:gnome-screenshot -i</Key>
  <Key key="XF86Display">exec:lxrandr</Key>
  <Mouse context="root" button="4">ldesktop</Mouse>
  <Mouse context="root" button="5">rdesktop</Mouse>
  <Mouse context="title" button="1">move</Mouse>
  <Mouse context="title" button="2">move</Mouse>
  <Mouse context="title" button="3">window</Mouse>
  <Mouse context="title" button="4">shade</Mouse>
  <Mouse context="title" button="5">shade</Mouse>
  <Mouse context="title" button="11">maximize</Mouse>
  <Mouse context="border" button="1">resize</Mouse>
  <Mouse context="border" button="2">move</Mouse>
  <Mouse context="close" button="-1">close</Mouse>
  <Mouse context="maximize" button="-1">maximize</Mouse>
  <Mouse context="minimize" button="-1">minimize</Mouse>
  <StartupCommand>xscreensaver -no-splash</StartupCommand>
</JWM>
